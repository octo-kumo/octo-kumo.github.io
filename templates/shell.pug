include ./mixins.pug

doctype html
html(lang="en", class="dark")
  head
    meta(charset="UTF-8")
    meta(name="viewport", content="width=device-width, initial-scale=1")
    title= title
    meta(name="description", content=description)
    link(rel="canonical", href=ogUrl)
    meta(property="og:site_name", content="云 · yun.ng")
    meta(property="og:title", content=ogTitle)
    meta(property="og:description", content=description)
    meta(property="og:url", content=ogUrl)
    meta(property="og:type", content=ogType)
    if ogImage
      meta(property="og:image", content=ogImage)
      meta(property="og:image:width", content="1200")
      meta(property="og:image:height", content="630")
      meta(property="og:image:alt", content=ogImageAlt)
    if ogType === "article"
      if ogPublishedTime
        meta(property="article:published_time", content=ogPublishedTime)
      if ogModifiedTime
        meta(property="article:modified_time", content=ogModifiedTime)
      each t in ogTags
        meta(property="article:tag", content=t)
      meta(property="article:author", content=siteBase + "/")
    // Twitter / X cards
    meta(name="twitter:card", content= ogImage ? "summary_large_image" : "summary")
    meta(name="twitter:title", content=ogTitle)
    meta(name="twitter:description", content=description)
    if ogImage
      meta(name="twitter:image", content=ogImage)
      if ogImageAlt
        meta(name="twitter:image:alt", content=ogImageAlt)
    link(rel="icon", type="image/x-icon", href="/favicon.ico?v=" + cacheVer)
    link(rel="alternate", type="application/rss+xml", title="RSS", href=siteBase + "/rss.xml")
    link(rel="alternate", type="application/atom+xml", title="Atom", href=siteBase + "/atom.xml")
    link(rel="preload", href="/fonts/roboto.woff2", as="font", type="font/woff2", crossorigin)
    link(rel="preload", href="/fonts/jetbrains-mono-400.woff2", as="font", type="font/woff2", crossorigin)
    // Self-hosted fonts, loaded non-blocking via JS swap (font-display: swap prevents FOIT)
    script.
      (function() {
        var d = document;
        function loadFonts() {
          var l = d.createElement('link');
          l.rel = 'stylesheet';
          l.href = '/fonts.css?v=' + '#{cacheVer}';
          d.head.appendChild(l);
        }
        // Load after first paint — font-display: swap makes this flicker-free
        if (d.readyState === 'loading') {
          d.addEventListener('DOMContentLoaded', loadFonts);
        } else {
          setTimeout(loadFonts, 50);
        }
      })();
    link(rel="stylesheet", href="/style.css?v=" + cacheVer)
    // Theme loader — must run before paint to prevent FOUC
    script.
      (function(){
        var c = localStorage.getItem('color') || 'dark';
        var s = localStorage.getItem('style') || 'default';
        // Migrate old single-theme to split color+style
        var old = localStorage.getItem('theme');
        if (old && !localStorage.getItem('color') && !localStorage.getItem('style')) {
          if (old === 'dark') { c = 'dark'; s = 'default'; }
          else if (old === 'papery') { c = 'light'; s = 'papery'; }
          else if (old === 'terminal') { c = 'dark'; s = 'terminal'; }
          localStorage.setItem('color', c);
          localStorage.setItem('style', s);
          localStorage.removeItem('theme');
        }
        var html = document.documentElement;
        html.classList.remove('dark','light','papery','terminal','style-default','style-papery','style-terminal');
        html.classList.add(c, 'style-' + s);
        if (s === 'terminal') html.classList.add('terminal');
        if (s === 'papery') html.classList.add('papery');
      })();
    script(defer, src="/theme.js?v=" + cacheVer)
    if umamiWebsiteId
      // Umami analytics — loaded off the critical path (idle/after-load) so the
      // /api/send beacon never shows up in LCP. Website ID from build env.
      script.
        (function() {
          var wid = '#{umamiWebsiteId}';
          if (!wid) return;
          function loadUmami() {
            var s = document.createElement('script');
            s.defer = true;
            s.src = 'https://anal.yun.ng/script.js';
            s.setAttribute('data-website-id', wid);
            s.setAttribute('data-performance', 'true');
            document.head.appendChild(s);
          }
          if ('requestIdleCallback' in window) {
            window.requestIdleCallback(loadUmami, { timeout: 2500 });
          } else {
            window.addEventListener('load', loadUmami);
          }
        })();
  body
    nav.topnav
      .topnav-inner
        a.topnav-logo(href="/", aria-label="yun.ng home")
          span.topnav-logo-mark 云
          span.topnav-logo-text yun.ng
        .topnav-links
          +nav-link("/c/ctf", "CTFs")
          +nav-link("/c/htb", "HTB")
          +nav-link("/c/blog", "Blog")
          span.topnav-sep(aria-hidden="true")
          +nav-link("/portfolio/", "Portfolio", { opener: true, newTab: true })
          +nav-link("https://utilbox.yun.ng/", "Tools")
        .topnav-spacer
        button.nav-search-btn#nav-search-btn(type="button", aria-haspopup="dialog", aria-controls="search-palette", aria-keyshortcuts="Control+K Meta+K /", title="Search writeups and posts")
          svg.nav-search-icon(viewBox="0 0 24 24", width="15", height="15", aria-hidden="true")
            circle(cx="11", cy="11", r="7", fill="none", stroke="currentColor", stroke-width="2")
            path(d="M20 20l-3.5-3.5", fill="none", stroke="currentColor", stroke-width="2", stroke-linecap="round")
          span.nav-search-label Search
          kbd.nav-search-kbd Ctrl K
        .topnav-tools
          .theme-group(role="group", aria-label="Typeface style")
            button.theme-btn-mini(data-style="default", onclick="setStyle('default')", title="Default sans-serif") Aa
            button.theme-btn-mini(data-style="papery", onclick="setStyle('papery')", title="Papery serif") ✎
            button.theme-btn-mini(data-style="terminal", onclick="setStyle('terminal')", title="Terminal monospace") >_
          button.theme-btn#color-btn(onclick="cycleColor()", title="Switch color") ◐
          button.hamburger#hamburger(onclick="toggleHamburger()", title="Menu", aria-label="Menu", aria-expanded="false", aria-controls="topnav-mobile") ☰
      .topnav-mobile#topnav-mobile
        +nav-link("/c/ctf", "CTFs")
        +nav-link("/c/htb", "HTB")
        +nav-link("/c/blog", "Blog")
        +nav-link("/portfolio/", "Portfolio", { opener: true, newTab: true })
        +nav-link("https://utilbox.yun.ng/", "Tools")
    //- Search palette (nav.js) — outside <main> so it survives view transitions
    dialog.search-palette#search-palette(aria-label="Search writeups and posts")
      .sp-panel
        .sp-head
          svg.sp-icon(viewBox="0 0 24 24", width="18", height="18", aria-hidden="true")
            circle(cx="11", cy="11", r="7", fill="none", stroke="currentColor", stroke-width="2")
            path(d="M20 20l-3.5-3.5", fill="none", stroke="currentColor", stroke-width="2", stroke-linecap="round")
          input#sp-input(type="text", placeholder="Search writeups and posts…", autocomplete="off", spellcheck="false", role="combobox", aria-expanded="true", aria-controls="sp-list", aria-autocomplete="list", aria-label="Search writeups and posts")
          button.sp-close(type="button", aria-label="Close search") esc
        .sp-filters#sp-filters(aria-label="Quick filters")
        .sp-syntax
          span.sp-syntax-label syntax
          button(type="button", data-insert='""') "phrase"
          button(type="button", data-insert="-") -exclude
          button(type="button", data-insert="tag:") tag:
          button(type="button", data-insert="ctf:") ctf:
          button(type="button", data-insert="cat:") cat:
        ul.sp-list#sp-list(role="listbox", aria-label="Results")
        .sp-foot
          span.sp-count#sp-count(aria-live="polite")
          span.sp-keys
            span
              kbd ↑
              kbd ↓
              |  move
            span
              kbd ↵
              |  open
            span
              kbd esc
              |  close
    main
      .main-grid
        .main-content
          != content
    if showComments
      .comments-container.comments-narrow
        #giscus-container-narrow
    footer
      p © #{year} Yun
    script(defer, src="/app.js?v=" + cacheVer)
    script(defer, src="/stats.js?v=" + cacheVer)
    // Homepage search/pagination — loaded globally (not inside <main>) so
    // view transitions from any page can render the home doc list
    script(defer, src="/search.js?v=" + cacheVer)
    script(defer, src="/nav.js?v=" + cacheVer)
    script(defer, src="/pagination.js?v=" + cacheVer)
    script(defer, src="/views.js?v=" + cacheVer)
    script(defer, src="/home.js?v=" + cacheVer)
